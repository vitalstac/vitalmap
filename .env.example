# --- LLM-Konfiguration (uniGPT oder lokaler Ollama-Fallback) ---
# Basis-URL der OpenAI-kompatiblen API (uniGPT oder lokal http://ollama:11434/v1)
LLM_BASE_URL=https://gpt.uni-muenster.de/v1
# Verwendetes Modell (uniGPT: DeepSeek-V4-Flash oder Qwen3.8-27B; lokal: qwen3:4b)
LLM_MODEL=DeepSeek-V4-Flash
# API-Schlüssel von https://gpt-api.uni-muenster.de (Generate Credential).
# Nur in die eigene .env eintragen, nie committen. Für Ollama nicht nötig.
LLM_API_KEY=your-api-key-here

# --- Geocoding & Basiskarte ---
# Endpunkt des Geocoding-Dienstes (Standard: Nominatim)
GEOCODER_URL=https://nominatim.openstreetmap.org
# Style-URL der Hintergrundkarte für MapLibreGL
BASEMAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# --- Interne Dienst-URLs (Docker Compose Netzwerk) ---
STAC_API_URL=http://stac-api:8080
TILE_SERVER_URL=http://tiler:8080

# --- Netzwerk & Datenbank ---
# Öffentliche Basis-URL, unter der die Webanwendung erreichbar ist
PUBLIC_BASE_URL=http://localhost:8080
# Zugangsdaten für die PostgreSQL/PostGIS-Datenbank (pgstac)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=pgstac
# Port, auf dem der Web-Container nach außen erreichbar ist
WEB_PORT=8080