{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://stac-extensions.github.io/health/v0.1.0/schema.json",
    "title": "STAC Health Extension",
    "description": "STAC Health Extension for STAC Items and STAC Collections",
    "oneOf": [
        {
            "$comment": "Validierung fuer STAC Items (Felder unter properties, alle optional)",
            "allOf": [
                {
                    "$ref": "#/definitions/stac_extensions"
                },
                {
                    "type": "object",
                    "required": ["type", "properties"],
                    "properties": {
                        "type": { "const": "Feature"},
                        "properties": {
                            "$ref": "#/definitions/fields"
                        }
                    }
                }
            ]
        },
        {
            "$comment": "Validierung fuer STAC Collections (Felder auf Root-Ebene, 3 Pflichtfelder",
            "allOf": [
                {
                    "$ref": "#/definitions/stac_extensions"
                },
                {
                    "type": "object",
                    "required": [
                        "type",
                        "health:status",
                        "health:update_frequency",
                        "health:representation_type"
                    ],
                    "properties": {
                        "type": { "const": "Collection" }
                    }
                },
                {
                    "$ref": "#/definitions/fields"
                }
            ]
        }

    ],
    "definitions": {
        "stac_extensions": {
            "type": "object",
            "required": ["stac_extensions"],
            "properties": {
                "stac_extensions": {
                    "type": "array",
                    "contains": {
                        "const": "https://github.io"
                    }
                }
            }
        },
        "spatial_codes": {
            "type": "string",
            "enum": [
                "vector",
                "grid",
                "textTable",
                "tin",
                "stereoModel",
                "video"
            ]
        },
        "fields": {
            "type": "object",
            "properties": {
                "health:status": {
                    "type": "string",
                    "enum": [
                        "completed",
                        "onGoing",
                        "planned",
                        "underDevelopment",
                        "historicalArchive",
                        "obsolete"
                    ]
                },
                "health:update_frequency": {
                    "type": "string",
                    "enum": [
                        "continual",
                        "daily",
                        "weekly",
                        "fortnightly",
                        "monthly",
                        "quarterly",
                        "biannually",
                        "annually",
                        "asNeeded",
                        "irregular",
                        "notPlanned",
                        "unknown"
                    ]
                },
                "health:representation_type": {
                    "type": "array", 
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "oneOf": [
                        {
                            "maxItems": 1,
                            "items": {"$ref": "#/definitions/spatial_codes"}
                        },
                        {
                            "minItems": 2,
                            "maxItems": 2,
                            "allOf": [
                                {"contains": {"$ref": "#/definitions/spatial_codes"}},
                                {"contains": {"const": "timeSeries"}}
                            ],
                            "items": {
                                "anyOf": [
                                    {"$ref": "#/definitions/spatial_codes"},
                                    {"const": "timeSeries"}
                                ]
                            }
                        }
                    ]
                },
                "health:spatial_resolution": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "health:temporal_resolution": {
                    "type": "string",
                    "pattern": "^P(?!$)(?:\\d+(?:\\.\\d+)?Y)?(?:\\d+(?:\\.\\d+)?M)?(?:\\d+(?:\\.\\d+)?W)?(?:\\d+(?:\\.\\d+)?D)?(?:T(?=\\d)(?:\\d+(?:\\.\\d+)?H)?(?:\\d+(?:\\.\\d+)?M)?(?:\\d+(?:\\.\\d+)?S)?)?$"
                },
                "health:scale": {
                    "type": "integer",
                    "minimum": 1
                },
                "health:format": {
                    "type" : "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "COG",
                            "GeoTIFF",
                            "NetCDF",
                            "Zarr",
                            "GeoJSON",
                            "FlatGeobuf",
                            "GeoParquet",
                            "GeoPackage",
                            "Shapefile",
                            "CSV",
                            "XLSX",
                            "Database",
                            "API"
                        ]
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "required": ["health:representation_type"],
                        "properties": {
                            "health:representation_type": {
                                "contains": {"const": "timeSeries"}
                            }
                        }
                    },
                    "then": {
                        "required": ["health:temporal_resolution"]
                    }
                }
            ]
        }
    }
}